{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open Vercel App in Chrome",
      "type": "shell",
      "command": "start chrome \"https://tow-truck-roadside-assistance.vercel.app/${fileBasename}\"",
      "problemMatcher": []
    },
    {
      "label": "Open Vercel App Home Page in Chrome",
      "type": "shell",
      "command": "start chrome \"https://tow-truck-roadside-assistance.vercel.app/\"",
      "problemMatcher": []
    },
    {
      "label": "Open Vercel App in Edge",
      "type": "shell",
      "command": "start msedge \"https://tow-truck-roadside-assistance.vercel.app/${fileBasename}\"",
      "problemMatcher": []
    },
    {
      "label": "Open Vercel App in Default Browser",
      "type": "shell",
      "command": "start \"\" \"https://tow-truck-roadside-assistance.vercel.app/${fileBasename}\"",
      "problemMatcher": []
    },
    {
      "label": "Open Vercel App Home Page in Default Browser",
      "type": "shell",
      "command": "start \"\" \"https://tow-truck-roadside-assistance.vercel.app/\"",
      "problemMatcher": []
    },
    {
      "label": "Start Local Server",
      "type": "shell",
      "command": "node server.js",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^RoadRescue Local Server starting...",
          "endsPattern": "^Server ready on port 8080"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": false
      }
    }
  ]
}
